# Generate .env and the private password file with: python scripts/init-env.py
DVT_IMAGE=data-visualization-tool:local
DVT_VERSION=dev
DVT_PORT=8000
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres_password
# GitHub Container Registry pull: set DVT_IMAGE=ghcr.io/your-github-namespace/data-visualization-tool:1.0.0
# Then docker login ghcr.io && docker compose -f compose.postgres.yaml up -d --no-build
